{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "excludeFiles": "{vendor/laravolt/indonesia/resources/csv/**,public/assets/vendor/**,public/assets/audio/**,public/assets-front-pages/**,public/assets/img/elements/**,public/assets/img/front-pages/**,public/assets/img/backgrounds/**}"
        }
    },
    "routes": [
        { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
        { "src": "/assets-front-pages/(.*)", "dest": "/public/assets-front-pages/$1" },
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/kta/(.*)", "dest": "/public/kta/$1" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
