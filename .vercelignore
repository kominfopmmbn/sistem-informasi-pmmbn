# Dependencies di-resolve ulang saat build Vercel
/node_modules

# Tidak diperlukan di runtime serverless
/tests
/.git
/.github
/references

# Media lokal pindah ke S3 (Supabase Storage); jangan ikut diunggah
/storage/app/public/*
/storage/app/private/*
/storage/logs/*

# File lingkungan & lokal
/.env
/.env.*
!/.env.vercel.example
/database/database.sqlite
/.phpunit.result.cache
