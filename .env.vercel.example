# =============================================================================
# Contoh environment variables untuk deploy ke Vercel.
# Salin nilainya ke Vercel → Project → Settings → Environment Variables.
# JANGAN commit nilai rahasia yang sebenarnya. File ini hanya referensi.
#
# Generate APP_KEY di lokal:  php artisan key:generate --show
# =============================================================================

APP_NAME="Sistem Informasi PMMBN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Log ke stderr karena filesystem read-only (ditangkap oleh Vercel Logs)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Compiled Blade views harus ke /tmp (config.view dievaluasi sebelum provider jalan)
VIEW_COMPILED_PATH=/tmp/storage/framework/views

# -----------------------------------------------------------------------------
# Database — Supabase (PostgreSQL)
# Runtime app: Transaction Pooler (port 6543).
# Untuk menjalankan migrasi dari lokal: pakai Session Pooler / direct (port 5432).
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<supabase-db-password>
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Session / Cache / Queue
# Tanpa worker persisten di Vercel → queue sync (email dikirim saat request).
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# -----------------------------------------------------------------------------
# PDF KTA — WAJIB dompdf (pure-PHP). JANGAN ganti ke browsershot (butuh Chromium).
# -----------------------------------------------------------------------------
LARAVEL_PDF_DRIVER=dompdf

# -----------------------------------------------------------------------------
# File storage — Supabase Storage (S3-compatible)
# Aktifkan "S3 Connection" di Supabase Storage untuk mendapat key & secret.
# Buat bucket (mis. "media") dan set public agar getUrl() bisa diakses.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
MEDIA_DISK=s3
# Batas body request Vercel/Lambda ~4.5MB → cap upload 4MB
MEDIA_MAX_FILE_SIZE=4194304
AWS_ACCESS_KEY_ID=<supabase-storage-access-key>
AWS_SECRET_ACCESS_KEY=<supabase-storage-secret>
AWS_DEFAULT_REGION=<region, mis. ap-southeast-1>
AWS_BUCKET=media
AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
AWS_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media
AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# Email — Brevo (SMTP, 300 email/hari gratis tanpa kartu)
# Verifikasi 1 sender di Brevo, lalu pakai SMTP key sebagai password.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<brevo-login>
MAIL_PASSWORD=<brevo-smtp-key>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<verified-sender@example.com>
MAIL_FROM_NAME="Sistem Informasi PMMBN"
